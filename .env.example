# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Signing key for session tokens (auto-generated in memory if unset).
SESSION_SECRET=

# ADMIN_INITIAL_PASSWORD: Optional initial administrator passcode override.
ADMIN_INITIAL_PASSWORD=
